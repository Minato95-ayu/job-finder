{
  "greenhouse": [
    {
      "name": "Greenhouse Demo",
      "board": "airbnb",
      "enabled": false
    }
  ],
  "lever": [
    {
      "name": "Lever Demo",
      "site": "netlify",
      "enabled": false
    }
  ],
  "rss": [
    {
      "name": "NCS India Government",
      "url": "https://www.ncs.gov.in/_layouts/15/ncsp/RssFeed.aspx?Source=Jobs",
      "enabled": true
    },
    {
      "name": "Employment News India",
      "url": "https://www.employmentnews.gov.in/NewEmp/Home.aspx",
      "enabled": true
    },
    {
      "name": "Prasar Bharati Jobs",
      "url": "https://prasarbharati.gov.in/category/vacancies/feed/",
      "enabled": true
    }
  ],
  "publicWebQueries": [
    {
      "name": "LinkedIn Public India",
      "query": "site:linkedin.com/jobs \"Software Engineer\" India",
      "enabled": true
    },
    {
      "name": "Naukri Public Search",
      "query": "site:naukri.com \"Software Engineer\" jobs in Bangalore",
      "enabled": true
    },
    {
      "name": "Indeed India Public",
      "query": "site:indeed.com \"Hiring\" India jobs",
      "enabled": true
    },
    {
      "name": "AngelList India",
      "query": "site:wellfound.com \"Software Engineer\" India startup",
      "enabled": true
    },
    {
      "name": "Glassdoor India Jobs",
      "query": "site:glassdoor.co.in \"Software Engineer\" India",
      "enabled": true
    },
    {
      "name": "GitHub Jobs India",
      "query": "site:github.com \"hiring\" India remote",
      "enabled": true
    }
  ],
  "scrapers": [
    {
      "name": "TimesJobs India",
      "url": "https://www.timesjobs.com/candidate/job-search.html?from=submit&searchTextFull={query}&searchType=personalizedSearch&luceneResultSize=25&postWeek=60&txtLocation={location}",
      "container": "div.relative.bg-white.rounded-lg",
      "selectors": {
        "title": "h2",
        "company": "p",
        "location": "div.text-sm",
        "link": "a.absolute",
        "description": "div.mt-4",
        "posted": "p.text-xs"
      },
      "enabled": true
    },
    {
      "name": "FoundIt India",
      "url": "https://www.foundit.in/srp/results?query={query}&locations={location}",
      "container": "div.srpResultCard",
      "selectors": {
        "title": "div.jobTitle",
        "company": "p.companyName",
        "location": "div.location",
        "link": "div.jobTitle a",
        "description": "div.jobDescription"
      },
      "enabled": true
    },
    {
      "name": "Internshala",
      "url": "https://internshala.com/jobs/keywords-{query}",
      "container": ".container-fluid.individual_internship",
      "selectors": {
        "title": ".job-internship-name",
        "company": ".company-name",
        "location": ".location_link",
        "link": "a",
        "description": ".job-description-details"
      },
      "enabled": true
    },
    {
      "name": "Shine India",
      "url": "https://www.shine.com/job-search/{query}-jobs-in-{location}",
      "container": "div[class*='jobCard_jobCard']",
      "selectors": {
        "title": "h2[class*='jobCard_jobCard_features_title'] a",
        "company": "div[class*='jobCard_jobCard_c__companyName']",
        "location": "div[class*='jobCard_jobCard_lists_item']",
        "link": "h2[class*='jobCard_jobCard_features_title'] a"
      },
      "enabled": true
    },
    {
      "name": "Freshersworld",
      "url": "https://www.freshersworld.com/jobs/jobsearch/{query}-jobs-in-{location}",
      "container": ".job-container",
      "selectors": {
        "title": "span.wrap-title",
        "company": ".company-name",
        "location": "span.job-location",
        "link": "a"
      },
      "enabled": true
    },
    {
      "name": "Jooble India",
      "url": "https://in.jooble.org/SearchResult?ukw={query}&rg={location}",
      "container": "article.job-card",
      "selectors": {
        "title": "h2.job-card__title",
        "company": "div.job-card__company",
        "location": "div.job-card__location",
        "link": "h2.job-card__title a"
      },
      "enabled": true
    },
    {
      "name": "Careerjet India",
      "url": "https://www.careerjet.co.in/search/jobs?s={query}&l={location}",
      "container": "article.job",
      "selectors": {
        "title": "h2 a",
        "company": "p.company",
        "location": "ul.location",
        "link": "h2 a"
      },
      "enabled": true
    },
    {
      "name": "SimplyHired India",
      "url": "https://www.simplyhired.co.in/search?q={query}&l={location}",
      "container": "li.list-item",
      "selectors": {
        "title": "h3",
        "company": "span[data-testimonial-auth]",
        "location": "span.job-location",
        "link": "a"
      },
      "enabled": true
    },
    {
      "name": "JobisJob India",
      "url": "https://www.jobisjob.co.in/search?q={query}&l={location}",
      "container": "li.job",
      "selectors": {
        "title": "h2 a",
        "company": "span.company",
        "location": "span.location",
        "link": "h2 a"
      },
      "enabled": true
    }
  ]
}


