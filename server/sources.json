{
  "greenhouse": [
    {
      "name": "Greenhouse Demo",
      "board": "airbnb",
      "enabled": false
    }
  ],
  "lever": [
    {
      "name": "Lever Demo",
      "site": "netlify",
      "enabled": false
    }
  ],
  "rss": [
    {
      "name": "NCS India Government",
      "url": "https://www.ncs.gov.in/_layouts/15/ncsp/RssFeed.aspx?Source=Jobs",
      "enabled": true
    },
    {
      "name": "Employment News India",
      "url": "https://www.employmentnews.gov.in/NewEmp/Home.aspx",
      "enabled": true
    },
    {
      "name": "Prasar Bharati Jobs",
      "url": "https://prasarbharati.gov.in/category/vacancies/feed/",
      "enabled": true
    }
  ],
  "publicWebQueries": [
    {
      "name": "Daily Career News",
      "query": "site:indiatimes.com \"hiring\" OR \"recruitment\" OR \"jobs\" software engineering",
      "enabled": true
    },
    {
      "name": "Startup Hiring News India",
      "query": "site:yourstory.com \"hiring\" OR \"raises series\" software engineer",
      "enabled": true
    },
    {
      "name": "Hackathons Datathons Public Web",
      "query": "India hackathon datathon internship hiring students college",
      "enabled": true
    },
    {
      "name": "Placement Questions Public Web",
      "query": "campus placement questions interview experience India engineering college",
      "enabled": true
    },
    {
      "name": "Public LinkedIn Pages Search",
      "query": "site:linkedin.com/jobs India hiring fresher software engineer",
      "enabled": true
    }
  ],
  "scrapers": [
    {
      "name": "TimesJobs India",
      "url": "https://www.timesjobs.com/candidate/job-search.html?from=submit&searchTextFull={query}&searchType=personalizedSearch&luceneResultSize=25&postWeek=60&txtLocation={location}",
      "container": "div.relative.bg-white.rounded-lg",
      "selectors": {
        "title": "h2",
        "company": "p",
        "location": "div.text-sm",
        "link": "a.absolute",
        "description": "div.mt-4",
        "posted": "p.text-xs"
      },
      "enabled": true
    },
    {
      "name": "FoundIt India",
      "url": "https://www.foundit.in/srp/results?query={query}&locations={location}",
      "container": "div.srpResultCard",
      "selectors": {
        "title": "div.jobTitle",
        "company": "p.companyName",
        "location": "div.location",
        "link": "div.jobTitle a",
        "description": "div.jobDescription"
      },
      "enabled": true
    },
    {
      "name": "Internshala",
      "url": "https://internshala.com/jobs/keywords-{query}",
      "container": ".container-fluid.individual_internship",
      "selectors": {
        "title": ".job-internship-name",
        "company": ".company-name",
        "location": ".location_link",
        "link": "a",
        "description": ".job-description-details"
      },
      "enabled": true
    },
    {
      "name": "Shine India",
      "url": "https://www.shine.com/job-search/{query}-jobs-in-{location}",
      "container": "div[class*='jobCard_jobCard']",
      "selectors": {
        "title": "h2[class*='jobCard_jobCard_features_title'] a",
        "company": "div[class*='jobCard_jobCard_c__companyName']",
        "location": "div[class*='jobCard_jobCard_lists_item']",
        "link": "h2[class*='jobCard_jobCard_features_title'] a"
      },
      "enabled": true
    },
    {
      "name": "Freshersworld",
      "url": "https://www.freshersworld.com/jobs/jobsearch/{query}-jobs-in-{location}",
      "container": ".job-container",
      "selectors": {
        "title": "span.wrap-title",
        "company": ".company-name",
        "location": "span.job-location",
        "link": "a"
      },
      "enabled": true
    }
  ]
}


