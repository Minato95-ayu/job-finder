{
  "greenhouse": [
    {
      "name": "Greenhouse Demo",
      "board": "airbnb",
      "enabled": false
    }
  ],
  "lever": [
    {
      "name": "Lever Demo",
      "site": "netlify",
      "enabled": false
    }
  ],
  "rss": [
    {
      "name": "Employment News RSS",
      "url": "https://www.employmentnews.gov.in/NewEmp/Home.aspx",
      "enabled": false
    }
  ],
  "publicWebQueries": [
    {
      "name": "Company Careers Public Web",
      "query": "India company careers jobs software engineer startup hiring",
      "enabled": true
    },
    {
      "name": "Hackathons Datathons Public Web",
      "query": "India hackathon datathon internship hiring students college",
      "enabled": true
    },
    {
      "name": "Placement Questions Public Web",
      "query": "campus placement questions interview experience India engineering college",
      "enabled": true
    },
    {
      "name": "Public LinkedIn Pages Search",
      "query": "site:linkedin.com/jobs India hiring fresher software engineer",
      "enabled": true
    }
  ],
  "scrapers": [
    {
      "name": "TimesJobs India",
      "url": "https://www.timesjobs.com/candidate/job-search.html?from=submit&searchTextFull={query}&searchType=personalizedSearch&luceneResultSize=25&postWeek=60&txtLocation={location}",
      "container": "li.clearfix.job-bx",
      "selectors": {
        "title": "h2 a",
        "company": "h3.joblist-comp-name",
        "location": "span",
        "link": "h2 a",
        "description": "ul.list-job-dtl",
        "posted": "span.sim-posted"
      },
      "enabled": true
    },
    {
      "name": "FoundIt India",
      "url": "https://www.foundit.in/srp/results?query={query}&locations={location}",
      "container": ".job-item",
      "selectors": {
        "title": ".job-title",
        "company": ".company-name",
        "location": ".location",
        "link": "a",
        "description": ".job-description"
      },
      "enabled": true
    },
    {
      "name": "Internshala",
      "url": "https://internshala.com/jobs/keywords-{query}",
      "container": ".container-fluid.individual_internship",
      "selectors": {
        "title": ".job-internship-name",
        "company": ".company-name",
        "location": ".location_link",
        "link": "a",
        "description": ".job-description-details"
      },
      "enabled": true
    },
    {
      "name": "Shine India",
      "url": "https://www.shine.com/job-search/{query}-jobs-in-{location}",
      "container": "div[itemprop='itemListElement']",
      "selectors": {
        "title": "a[itemprop='name']",
        "company": ".jobCard_jobCard_cName__m_HUE",
        "location": ".jobCard_jobCard_lists__fdnsc",
        "link": "a[itemprop='name']"
      },
      "enabled": true
    },
    {
      "name": "Freshersworld",
      "url": "https://www.freshersworld.com/jobs/jobsearch/{query}-jobs-in-{location}",
      "container": ".job-container",
      "selectors": {
        "title": ".job-title",
        "company": ".company-name",
        "location": ".job-location",
        "link": "a"
      },
      "enabled": true
    }
  ]
}


