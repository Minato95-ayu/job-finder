    "cheerio": "^1.2.0",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-xml-parser": "^4.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
