{
  "name": "ayush-job-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade career intelligence platform built for high-scale job discovery and AI-powered resume matching.",
  "author": "Ayush",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"vite --host 127.0.0.1\"",
    "client": "vite --host 127.0.0.1",
    "api": "npx kill-port 4000 && node server/src/index.js",
    "start": "node server/src/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
